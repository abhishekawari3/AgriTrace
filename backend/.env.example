# ── Server ─────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB ─────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/agritrace
# For Atlas: MONGO_URI=mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/agritrace

# ── JWT ─────────────────────────────────────────────────────────────────
JWT_SECRET=agritrace_super_secret_key_change_in_production

# ── Frontend URL ────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Blockchain (production only — swap blockchain/index.js for ethers.js) ──
ETHEREUM_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
CONTRACT_ADDRESS=0xYourDeployedContractAddress
DEPLOYER_PRIVATE_KEY=0xYourWalletPrivateKey
